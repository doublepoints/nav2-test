<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_sim_tesi_ros2_nodes</name>
  <version>0.0.0</version>
  <description>ROS 2 node package</description>
  <maintainer email="zijun_sha@mail.toyota.co.jp">Marco Agatensi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>my_sim_tesi_ros2_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp_components</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>rosgraph_msgs</depend>
  <!-- 如果你需要odom_to_tf_node.py，则需要这个依赖 -->
  <!-- <depend>tf2_ros</depend> -->
  
  <!-- Python依赖 - 用于Livox转换器 -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>  <!-- 新增：用于高度分析工具 -->



  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
